[Unit]
Description=Sniper V1 Trading Bot
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sniper-v1
Environment=PATH=/home/ubuntu/sniper-v1/venv/bin
ExecStart=/home/ubuntu/sniper-v1/venv/bin/python main.py
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/home/ubuntu/sniper-v1/logs/bot.log
StandardError=append:/home/ubuntu/sniper-v1/logs/error.log

# Security
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/home/ubuntu/sniper-v1

[Install]
WantedBy=multi-user.target
